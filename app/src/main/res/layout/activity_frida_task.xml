<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/glass_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="调试任务"
            android:textColor="@color/glass_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="目标应用"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/glass_accent_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="方法 Hook"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="填类名 + 方法名，点生成脚本（可再编辑）"
                        android:textColor="@color/glass_text_tertiary"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_class"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="类名（可填关键字后搜索）"
                            android:inputType="text"
                            android:textColor="@color/glass_text_primary"
                            android:textColorHint="@color/glass_text_tertiary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btn_search_class"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="搜索类"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_method"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="方法名，如 isVip"
                            android:inputType="text"
                            android:textColor="@color/glass_text_primary"
                            android:textColorHint="@color/glass_text_tertiary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/btn_list_method"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginLeft="8dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:text="列方法"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cb_args"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="打印参数"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp" />

                        <CheckBox
                            android:id="@+id/cb_ret"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:checked="true"
                            android:text="打印返回值"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp" />

                        <CheckBox
                            android:id="@+id/cb_stack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="堆栈"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cb_override"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="篡改返回值"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_override"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="表达式 true / 1 / &quot;abc&quot;"
                            android:inputType="text"
                            android:textColor="@color/glass_text_primary"
                            android:textColorHint="@color/glass_text_tertiary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cb_override_args"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="篡改参数"
                            android:textColor="@color/glass_text_primary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_arg_index"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:hint="下标"
                            android:inputType="number"
                            android:textColor="@color/glass_text_primary"
                            android:textColorHint="@color/glass_text_tertiary"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_arg_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="新值表达式，如 1 / true / &quot;abc&quot;"
                            android:inputType="text"
                            android:textColor="@color/glass_text_primary"
                            android:textColorHint="@color/glass_text_tertiary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_condition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent"
                        android:hint="条件断点（可选），如 arg0 == 5"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_tertiary"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/cb_bypass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="反调试旁路（isDebuggerConnected 等）"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_gen"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_glass_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="生成脚本"
                        android:textColor="@color/glass_accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_save_bp"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_glass_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="保存为断点"
                        android:textColor="@color/glass_accent_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="脚本（可编辑后注入）"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_import_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="导入文件"
                    android:textColor="@color/glass_accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_paste_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="粘贴脚本"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="清空"
                    android:textColor="@color/glass_accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_script_len"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:gravity="right|center_vertical"
                    android:text="0 字符"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_script"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/glass_text_primary"
                android:textSize="11sp"
                android:typeface="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_inject"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="注入并运行"
                    android:textColor="@color/glass_accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_uninject"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="取消注入"
                    android:textColor="@color/glass_accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_readout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="刷新输出"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="输出"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />

            <ScrollView
                android:id="@+id/scroll_out"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_glass_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
